{
  "name": "payment-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "clean": "rimraf node_modules dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 start dist/index.js --name payment-service",
    "pm2:stop": "pm2 stop payment-service",
    "pm2:restart": "pm2 restart payment-service",
    "pm2:delete": "pm2 delete payment-service",
    "pm2:logs": "pm2 logs payment-service",
    "pm2:status": "pm2 status",
    "deploy": "git pull origin main && npm install && npm run build && pm2 restart payment-service"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@cashfreepayments/cashfree-sdk": "^0.1.7",
    "axios": "^1.15.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mongoose": "^9.4.1",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
