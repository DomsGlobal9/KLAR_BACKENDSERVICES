# KLAR CRM Email Service — required configuration.
# Copy to .env and fill in real values. Never commit the filled-in file.

# Selects the target database. Must be exactly one of: development | production | test
# The service refuses to start if this is missing or misspelled.
NODE_ENV=development
PORT=5013

# Database. Only the URL matching NODE_ENV is required:
#   NODE_ENV=production  -> SUPABASE_PRODUCTION_DATABASE_URL
#   NODE_ENV=development -> SUPABASE_DEVELOPMENT_DATABASE_URL
# A production host does not need the development URL at all.
# Startup fails if production resolves to the same Supabase project as development.
SUPABASE_DEVELOPMENT_DATABASE_URL=postgresql://USER:PASSWORD@DEV_POOLER_HOST:6543/postgres
SUPABASE_PRODUCTION_DATABASE_URL=postgresql://USER:PASSWORD@PROD_POOLER_HOST:6543/postgres

# AWS (SES receive/send + S3 bucket holding raw messages)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

EMAIL_DOMAIN=
SES_FROM_EMAIL=

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS
CORS_ORIGIN=
CORS_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400
