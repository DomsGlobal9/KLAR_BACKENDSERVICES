{
  "name": "flight-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "clean": "rimraf node_modules dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 start dist/index.js --name flight-service",
    "pm2:stop": "pm2 stop flight-service",
    "pm2:restart": "pm2 restart flight-service",
    "pm2:delete": "pm2 delete flight-service",
    "pm2:logs": "pm2 logs flight-service",
    "pm2:status": "pm2 status",
    "deploy": "git pull && npm install && npm run build && pm2 restart flight-service"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "mongoose": "^9.4.1",
    "node-cron": "^4.2.1",
    "puppeteer": "^24.43.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
}
