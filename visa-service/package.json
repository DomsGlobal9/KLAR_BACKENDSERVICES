{
  "name": "visa-service",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "clean": "rimraf node_modules dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 start dist/server.js --name visa-service",
    "pm2:stop": "pm2 stop visa-service",
    "pm2:restart": "pm2 restart visa-service",
    "pm2:delete": "pm2 delete visa-service",
    "pm2:logs": "pm2 logs visa-service",
    "pm2:status": "pm2 status",
    "deploy": "git pull && npm install && npm run build && pm2 restart visa-service"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "mongoose": "^9.7.4",
    "rimraf": "^6.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/node": "^26.1.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
