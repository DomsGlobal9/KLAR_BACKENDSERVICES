{
  "name": "tour-package-service",
  "version": "1.0.0",
  "description": "Microservice for managing tours and holiday packages",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "clean": "rimraf node_modules dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 start dist/server.js --name tour-package-service",
    "pm2:stop": "pm2 stop tour-package-service",
    "pm2:restart": "pm2 restart tour-package-service",
    "pm2:delete": "pm2 delete tour-package-service",
    "pm2:logs": "pm2 logs tour-package-service",
    "pm2:status": "pm2 status",
    "deploy": "git pull && npm install && npm run build && pm2 restart tour-package-service"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.4.1",
    "zod": "^4.3.6"
  }
}